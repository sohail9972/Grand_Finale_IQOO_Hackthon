<?xml version="1.0" encoding="utf-8"?>
<!--
  XML theme. Compose supplies the real design system (see ui/theme/Theme.kt);
  this file only styles the window before Compose takes over, so the app never
  flashes a white screen on a dark-themed product.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AnimalHealthBridge" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ahb_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
</resources>