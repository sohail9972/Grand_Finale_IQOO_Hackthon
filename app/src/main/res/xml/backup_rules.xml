<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below backup rules. The Room database and the DataStore
  preferences file are included so a farmer who changes phones keeps their
  animals' longitudinal health records.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
</full-backup-content>