<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. Health records are the whole point of the
  app, so they are carried across device transfers and cloud backups. Cached
  model scratch files are excluded to keep backups small.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="models_tmp/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>